# Production build settings. Everything here is public on-chain or a public
# endpoint, so it lives in git rather than in a host's dashboard: a build run
# anywhere — Vercel, CI, a laptop — then produces the same working app.
# (`.env` stays local and only matters for `npm start`.)
REACT_APP_YIELDS_API=https://stakechain-api.vercel.app
REACT_APP_STACH_ADDRESS=0x82c5f9901CD9AEE3177053482b79aEA235507166
REACT_APP_CHAIN=base
# STACH mainnet deploy height: where personal history scans start
REACT_APP_STACH_DEPLOY_BLOCK=53190000
GENERATE_SOURCEMAP=false
