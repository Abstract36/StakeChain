  },
  "devDependencies": {
    "@nomiclabs/hardhat-ethers": "^2.2.3",
    "@nomicfoundation/hardhat-chai-matchers": "^1.0.6",
    "@nomicfoundation/hardhat-verify": "^2.0.8",
    "chai": "^4.3.10",
    "dotenv": "^16.4.5",
    "ethers": "^5.7.2",
    "hardhat": "^2.26.1"
  }
}
