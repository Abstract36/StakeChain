{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-07-09/server.schema.json",
  "name": "io.github.Abstract36/stakechain",
  "description": "Live Base staking/lending yields (APY, TVL, vaults) as MCP tools; x402 pay-per-request tier",
  "repository": {
    "url": "https://github.com/Abstract36/StakeChain",
    "source": "github"
  },
  "version": "0.4.0",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://stakechain-api.vercel.app/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "stakechain-mcp",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "STAKECHAIN_API",
          "description": "Yields API base URL",
          "isRequired": false,
          "default": "https://stakechain-api.vercel.app"
        }
      ]
    }
  ]
}
